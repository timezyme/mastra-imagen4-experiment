{
  "name": "mastra-arxiv-imagen4",
  "version": "1.0.0",
  "description": "Mastra.ai workflow for generating images from arXiv papers using Imagen4",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mastra",
    "vertex-ai",
    "imagen4",
    "arxiv",
    "ai-workflow"
  ],
  "dependencies": {
    "@ai-sdk/google-vertex": "^3.0.61",
    "@google/genai": "^1.29.0",
    "@mastra/core": "^0.24.0",
    "ai": "^5.0.90",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
