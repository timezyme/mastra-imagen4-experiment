# Google Cloud / Vertex AI Configuration
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# Vertex AI Region (optional, defaults to us-central1)
GOOGLE_REGION=us-central1

# JSON Extraction Configuration
JSON_EXTRACT_LINES=100

# Image Generation Configuration
# Note: Imagen 4 uses aspect ratios (1:1, 9:16, 16:9, 3:4, 4:3)
# The app will map your width/height to the closest aspect ratio
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_OUTPUT_DIR=./images/arxiv

# Optional: Override the default JSON file path and paper ID
# JSON_FILE_PATH=./arxiv/2502.14902/sections-extract.json
# PAPER_ID=2502.14902
